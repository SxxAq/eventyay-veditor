# ==============================================================================
# Eventyay VEditor Plugin Configuration (.env.example)
# ==============================================================================

# Base URL of the VEditor backend service
# Local FastAPI dev server: http://localhost:8000 or http://127.0.0.1:8000
# Docker Compose network: http://veditor:8000
VEDITOR_API_BASE_URL=http://localhost:8000

# Secret API Key provisioned in VEditor for this Eventyay client
# Generate in VEditor: python -m app.cli admin create-client --event-name "FOSSASIA Summit"
VEDITOR_API_KEY=veditor_live_api_key_example

# Shared secret for verifying incoming HMAC-SHA256 signatures on webhooks (X-Veditor-Signature)
# Must match the webhook secret configured in VEditor
# Can also be set per-event in the Eventyay Organizer settings UI
VEDITOR_WEBHOOK_SECRET=veditor_shared_webhook_secret_example_hex

# Optional: HTTP request timeout in seconds when communicating with VEditor API (default: 10)
VEDITOR_REQUEST_TIMEOUT=10

# Optional: Comma-separated list of allowed host origins for VEditor browser handoffs & redirects
# Defaults to localhost, 127.0.0.1, and the host from VEDITOR_API_BASE_URL
VEDITOR_ALLOWED_ORIGINS=localhost:8000,127.0.0.1:8000

# Redis broker URL for async Celery task execution (inherited from Eventyay)
# REDIS_URL=redis://localhost:6379/0
